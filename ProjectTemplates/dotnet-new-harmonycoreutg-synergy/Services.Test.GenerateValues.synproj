<Project Sdk="Microsoft.NET.Sdk" DefaultTargets="restore;Build">
  <Import Project="$(SolutionDir)Common.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFrameworkOverride)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFrameworkOverride)' != ''">TargetFrameworkOverride</TargetFramework>
    <DefaultLanguageSourceExtension>.dbl</DefaultLanguageSourceExtension>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ProjectGuid>{518fa7fa-9bcd-420b-a7f5-1f02aa5df595}</ProjectGuid>
	<ProjectTypeGuids>{BBD0F5D1-1CC4-42FD-BA4C-A96779C64378}</ProjectTypeGuids>
    <Name>Services.Test.GenerateValues</Name>
    <StartupObject>Services.Test.GenerateValues</StartupObject>
    <Prefer32Bit>False</Prefer32Bit>
    <IncludeDebugInformation>False</IncludeDebugInformation>
    <!-- Microsoft.Testing.Platform targets (transitive via MSTest 3.6+) generate C#/VB/F#
         sources and fail with "Language 'Synergy' is not supported"; opt out — this project
         has its own main (mirrors HarmonyCore's Services.Test.GenerateValues.synproj) -->
    <GenerateTestingPlatformEntryPoint>False</GenerateTestingPlatformEntryPoint>
    <GenerateSelfRegisteredExtensions>False</GenerateSelfRegisteredExtensions>
    <ProvidesMainMethod>true</ProvidesMainMethod>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath />
  </PropertyGroup>
  <ItemGroup>
    <!-- The generated GenerateTestValues.dbl calls Services.Test.UnitTestEnvironment
         .AssemblyInitialize, whose signature uses MSTest's TestContext. dblnet resolves
         types surfaced in a referenced project's public signatures only from DIRECT
         package references (transitive flow through the ProjectReference is not enough),
         so this project must reference MSTest.TestFramework itself. -->
    <PackageReference Include="MSTest.TestFramework">
      <Version>3.6.1</Version>
    </PackageReference>
    <PackageReference Include="Synergex.SynergyDE.Build">
      <Version>26.8.1648</Version>
    </PackageReference>
    <PackageReference Include="Synergex.SynergyDE.synrnt">
      <Version>12.4.1.1005</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="GenerateTestValues.dbl" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Repository\Repository.synproj"/>
    <ProjectReference Include="..\Services.Test\Services.Test.synproj"/>
  </ItemGroup>
</Project>